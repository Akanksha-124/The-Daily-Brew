# The Daily Brew — Environment Configuration Example
# Copy this file to .env for local development

# Application Port
VITE_PORT=5173

# Application URL
VITE_APP_URL=http://localhost:5173

# Payment Gateway (Demo Mode Active by default)
VITE_ENABLE_PAYMENT_GATEWAY=false
